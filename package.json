{
  "name": "arabic-pdf-repair",
  "version": "0.3.3",
  "description": "Make Arabic text in old PDFs copyable and searchable again (glyph names, Windows-1256 and Latin-slot fonts, Diwan XT) without changing how pages look.",
  "license": "Apache-2.0",
  "homepage": "https://genpdf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velnixdev/arabic-pdf-repair.git"
  },
  "bugs": {
    "url": "https://github.com/velnixdev/arabic-pdf-repair/issues"
  },
  "keywords": [
    "arabic",
    "pdf",
    "tounicode",
    "text-extraction",
    "copy-paste",
    "rtl",
    "repair",
    "persian",
    "urdu",
    "windows-1256",
    "cff",
    "ocr-alternative",
    "pdf-lib"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "arabic-pdf-repair": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^20.0.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
